# Copy this file to .env and fill in your keys, then set DEMO_MODE = False in settings.py.
# eBay Browse API — https://developer.ebay.com (free; production approval needed for live listings)
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
# Google Gemini — https://aistudio.google.com (free, no credit card)
GEMINI_API_KEY=your_gemini_api_key

# Optional. Where the history database and uploaded photos go.
# Leave them out to use deal_scout.db and uploads/ next to the code.
# DEALSCOUT_DB_PATH=/full/path/to/deal_scout.db
# DEALSCOUT_UPLOADS_DIR=/full/path/to/uploads

# DEALSCOUT_ENV_FILE picks which .env file to load. It is set in the shell,
# not in this file, for example:
#   DEALSCOUT_ENV_FILE=/full/path/to/other.env python dealscout.py
